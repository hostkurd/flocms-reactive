{
  "name": "hostkurd/flocms-reactive",
  "description": "Optional reactive PHP components for FloCMS, with server-rendered HTML updates.",
  "type": "library",
  "license": "MIT",
  "require": { "php": "^8.1", "ext-json": "*", "ext-mbstring": "*", "hostkurd/flocms-core": "^2.3.2" },
  "require-dev": { "phpunit/phpunit": "^10.5 || ^11.0" },
  "autoload": { "psr-4": { "FloCMS\\Reactive\\": "src/" }, "files": ["bootstrap.php"] },
  "autoload-dev": { "psr-4": { "FloCMS\\Reactive\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "extra": { "branch-alias": { "dev-main": "0.1-dev" } }
}
