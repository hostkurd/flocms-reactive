{
  "name": "hostkurd/flocms-reactive",
  "description": "Optional reactive PHP components for FloCMS, with server-rendered HTML updates.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "hostkurd/flocms-core": "^2.3.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "FloCMS\\Reactive\\": "src/"
    },
    "files": [
      "bootstrap.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "FloCMS\\Reactive\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/node_modules",
      "/tests",
      "/.github",
      "/.ci",
      "/examples",
      "/scripts",
      "/composer.local.*",
      "/composer.lock",
      "/.phpunit.cache",
      "/test-results",
      "/playwright-report",
      "/package.json",
      "/package-lock.json",
      "/tsconfig.json",
      "/vite.config.ts",
      "/playwright.config.ts",
      "/phpunit.xml.dist"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.5-dev"
    }
  }
}
